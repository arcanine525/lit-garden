{
  "name": "vuon-van",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "auth:bootstrap": "node --env-file-if-exists=.env.local infra/keycloak/bootstrap.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local infra/db/migrate.mjs",
    "test:db": "node --env-file-if-exists=.env.local --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "stack:setup": "sh scripts/dev-stack.sh setup",
    "stack:up": "sh scripts/dev-stack.sh up",
    "stack:down": "sh scripts/dev-stack.sh down"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "next": "16.4.6",
    "openid-client": "6.9.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.9.3"
  }
}
